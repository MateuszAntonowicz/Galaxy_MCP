      RightMDRDiagnostic { S7_HMI_Visible := 'False'} : Struct   // Right MDR diagnostics .
         Overheat { S7_HMI_Visible := 'False'} : Bool;   // The MDR 's temperature has exceeded 105 degrees Celsius
         MaxTorque { S7_HMI_Visible := 'False'} : Bool;   // The MDR is running with maximum torque output
         ShortCircuit { S7_HMI_Visible := 'False'} : Bool;   // There is a short circuit on the MDR
         MDRNotConnected { S7_HMI_Visible := 'False'} : Bool;   // The MDR is not connected
         Overload { S7_HMI_Visible := 'False'} : Bool;   // The MDR has been overloaded - this means its speed is less than 10% of the selected speed
         Stalled { S7_HMI_Visible := 'False'} : Bool;   // The MDR has stalled
         MDRBadHall { S7_HMI_Visible := 'False'} : Bool;   // The MDR has a Hall Efect Sensor error
         MDRNotUsed { S7_HMI_Visible := 'False'} : Bool;   // The MDR is not used
         MDRStatus1 { S7_HMI_Visible := 'False'} : Bool;   // This field and the next are used together by the module to indicate the status of the MDR. Please refer to documentation
         MDRStatus2 { S7_HMI_Visible := 'False'} : Bool;
         Reserved { S7_HMI_Visible := 'False'} : Bool;
         Reserved1 { S7_HMI_Visible := 'False'} : Bool;
         Reserved2 { S7_HMI_Visible := 'False'} : Bool;
         Reserved3 { S7_HMI_Visible := 'False'} : Bool;
         OverVoltage { S7_HMI_Visible := 'False'} : Bool;   // The sum of the module power supply voltage + the MDR-generated voltage has exceeded 30 volts
         LowVoltage { S7_HMI_Visible := 'False'} : Bool;   // Module power supply is less than 18 Volts
      END_STRUCT;
      Reserved : Word;
      Reserved_1 : Word;
   END_STRUCT;

END_TYPE

TYPE "ECCDFCPLC_OUT"
VERSION : 0.1
   STRUCT
      ConveyStopControl { S7_HMI_Visible := 'False'} : Word;   // Writing '1' causes the Stop group to go into STOP state . Writing '2' clears the STOP state. Transition 0 - 2 is needed to clear the Stop
      Reserved_3 : Word;
      Reserved_4 : Word;
      SensorPortsDO { S7_HMI_Visible := 'False'} : Struct   // The Sensor ports PIN2 as  digital outputs
         "Reserved[0]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[1]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[2]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[3]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[4]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[5]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[6]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[7]" { S7_HMI_Visible := 'False'} : Bool;
         DriveLeftPIN2 { S7_HMI_Visible := 'False'} : Bool;   // Setting this bit drives the Left PIN2 to logical 1
         DriveRightPIN2 { S7_HMI_Visible := 'False'} : Bool;   // Setting this bit drives the Right PIN2 to logical 1
         "Reserved[10]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[11]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[12]" { S7_HMI_Visible := 'False'} : Bool;
         SetLeftPIN2asDO { S7_HMI_Visible := 'False'} : Bool;   // Setting this bit sets the Left PIN2 to be used as Digital Output / 0 = Digital input
         SetRightPIN2asDO { S7_HMI_Visible := 'False'} : Bool;   // Setting this bit sets the Right PIN2 to be used as Digital Output/ 0 = Digital input
         "Reserved[15]" { S7_HMI_Visible := 'False'} : Bool;
      END_STRUCT;
      LeftMDRControl { S7_HMI_Visible := 'False'} : Struct   // Run/Stop and Direction control of the Left MDR
         MDR_Direction { S7_HMI_Visible := 'False'} : Bool;   // 0 = Configured direction /1 = opposite to configured direction
         "Reserved[1]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[2]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[3]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[4]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[5]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[6]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[7]" { S7_HMI_Visible := 'False'} : Bool;
         Run_MDR { S7_HMI_Visible := 'False'} : Bool;   // MDR Run = 1 / MDR Stop = 0
         "Reserved[9]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[10]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[11]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[12]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[13]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[14]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[15]" { S7_HMI_Visible := 'False'} : Bool;
      END_STRUCT;
      LeftMDRBrakeMode { S7_HMI_Visible := 'False'} : Word;   // The Break mode of the Left MDR . 1 = "Normal" / 2 = "Free" / 3 ="Servo break"
      Reserved_1 { S7_HMI_Visible := 'False'} : Word;
      RightMDRControl { S7_HMI_Visible := 'False'} : Struct   // Run/Stop and Direction control of the Right MDR
         MDR_Direction { S7_HMI_Visible := 'False'} : Bool;   // 0 = Configured direction /1 = opposite to configured direction
         "Reserved[1]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[2]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[3]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[4]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[5]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[6]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[7]" { S7_HMI_Visible := 'False'} : Bool;
         Run_MDR { S7_HMI_Visible := 'False'} : Bool;   // MDR Run = 1 / MDR Stop = 0
         "Reserved[9]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[10]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[11]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[12]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[13]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[14]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[15]" { S7_HMI_Visible := 'False'} : Bool;
      END_STRUCT;
      RightMDRBrakeMode { S7_HMI_Visible := 'False'} : Word;   // The Break mode of the Right MDR . 1 = "Normal" / 2 = "Free" / 3 ="Servo break"
      Reserved_2 { S7_HMI_Visible := 'False'} : Word;
      LeftMDRSpeed { S7_HMI_Visible := 'False'} : Int;   // The speed of the MDR in m/s*1000 (or in shaft RPM*10 for ECG) . The allowed values depend on the Speed code of the MDR .
      RightMDRSpeed { S7_HMI_Visible := 'False'} : Int;   // The speed of the MDR in m/s*1000(or in shaft RPM*10 for ECG) . The allowed values depend on the Speed code of the MDR .
      LeftMDRAccel { S7_HMI_Visible := 'False'} : Int;   // The Acceleration of the left MDR given in "mm" (or in pulses for ECG)
      LeftMDRDeccel { S7_HMI_Visible := 'False'} : Int;   // The Deceleration of the left MDR given in "mm" (or in pulses for ECG)
      RightMDRAccel { S7_HMI_Visible := 'False'} : Int;   // The Acceleration of the right MDR given in "mm" (or in pulses for ECG)
      RightMDRDeccel { S7_HMI_Visible := 'False'} : Int;   // The Deceleration of the right MDR given in "mm" (or in pulses for ECG)
      ClearMDRError { S7_HMI_Visible := 'False'} : Word;   // Writing '1' to this field clears the MDR error .There needs to be a transition from 0 to 1 in order to clear the error .
      StatusToDownstream { S7_HMI_Visible := 'False'} : Word;   // The ZPA status of our Downstream zone can be written here . A ECC-DFC-24-00 module in ZPA mode can read this and "Wake up " to accept product
      StatusToUpstream { S7_HMI_Visible := 'False'} : Word;   // The ZPA status of our Upstream zone can be written here . A ECC-DFC-24-00 module in ZPA mode can read this know we have received the product
      SensorPolarity { S7_HMI_Visible := 'False'} : Struct   // From here the polarity of our Left/Right PIN2/PIN4 can be set
         "Reserved[0]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[1]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[2]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[3]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[4]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[5]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[6]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[7]" { S7_HMI_Visible := 'False'} : Bool;
         Left_Pin2 { S7_HMI_Visible := 'False'} : Bool;   // Normal polarity = 0 / Inverted polarity = 1
         "Reserved[9]" { S7_HMI_Visible := 'False'} : Bool;
         Right_Pin2 { S7_HMI_Visible := 'False'} : Bool;   // Normal polarity = 0 / Inverted polarity = 1
         "Reserved[11]" { S7_HMI_Visible := 'False'} : Bool;
         Left_Pin4 { S7_HMI_Visible := 'False'} : Bool;   // Normal polarity = 0 / Inverted polarity = 1
         "Reserved[13]" { S7_HMI_Visible := 'False'} : Bool;
         Right_Pin4 { S7_HMI_Visible := 'False'} : Bool;   // Normal polarity = 0 / Inverted polarity = 1
      END_STRUCT;
      TrackingToDownstream { S7_HMI_Visible := 'False'} : DWord;   // This field can be used to send Tracking data to a downstream ZPA mode ECC-DFC-24-00
      Reserved { S7_HMI_Visible := 'False'} : Word;
      ServoControlDistanceLeft { S7_HMI_Visible := 'False'} : DInt;   // New MDR distance to be traveled in 'mm' (or in pulses for ECG)
      ServoControlCommandLeft { S7_HMI_Visible := 'False'} : Word;   // Left MDR servo command
      ServoControlDistanceRight { S7_HMI_Visible := 'False'} : DInt;   // New MDR distance to be traveled in 'mm' (or in pulses for ECG)
      ServoControlCommandRight { S7_HMI_Visible := 'False'} : Word;   // Right MDR servo command
      Future { S7_HMI_Visible := 'False'} : Array[29..31] of Word;
   END_STRUCT;

END_TYPE

