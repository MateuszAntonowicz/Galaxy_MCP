END_TYPE

TYPE "ECCDFCZPAmini_IN"
VERSION : 0.1
   STRUCT
      StateUpstreamZoneInverce { S7_HMI_Visible := 'False'} : Byte;   // Zone status when the conveyor is running in opposite to configured direction .The values have the same meaning as in "StateUpstreamZone" field
      StateUpstreamZone { S7_HMI_Visible := 'False'} : Byte;   // Empty =1 /Empty Motor Run = 2 /Empty Sending = 3 / Full Running = 4 / Full Stopped = 5 / Empty but Accumulate = 6
      StateDownstreamZoneInverce { S7_HMI_Visible := 'False'} : Byte;   // Zone status when the conveyor is running in opposite to configured direction  .The values have the same meaning as in "StateDownstreamZone" field
      StateDownstreamZone { S7_HMI_Visible := 'False'} : Byte;   // Empty =1 /Empty Motor Run = 2 /Empty Sending = 3 / Full Running = 4 / Full Stopped = 5 / Empty but Accumulate = 6
      ArrivalCounterUpstreamZone { S7_HMI_Visible := 'False'} : Int;   // Every time a product arrives on the Upstream zone this counter is incremented
      DisarrivalCounterUpstreamZone { S7_HMI_Visible := 'False'} : Int;   // Every time a product leaves the Upstream zone this counter is incremented
      ArrivalCounterDownstreamZone { S7_HMI_Visible := 'False'} : Int;   // Every time a product arrives on the Downstream zone this counter is incremented
      DisarrivalCounterDownstreamZone { S7_HMI_Visible := 'False'} : Int;   // Every time a product leaves the Downstream zone this counter is incremented
      Diagnostic { S7_HMI_Visible := 'False'} : Struct   // 32 bit diagnostic field . When bits are set the error is active .
         LeftMDR_Overheat { S7_HMI_Visible := 'False'} : Bool;   // The Left MDR temperature has exceeded 105 degrees Celsius
         LeftMDR_MaxTorque { S7_HMI_Visible := 'False'} : Bool;   // The Left MDR is running with maximum torque output
         LeftMDR_Short { S7_HMI_Visible := 'False'} : Bool;   // There is a short circuit on the Left MDR
         LeftMDR_NotConn { S7_HMI_Visible := 'False'} : Bool;   // The Left MDR is not connected
         LeftMDR_Overload { S7_HMI_Visible := 'False'} : Bool;   // The Left MDR has been overloaded - this means its speed is less than 10% of the selected speed
         LeftMDR_Stalled { S7_HMI_Visible := 'False'} : Bool;   // The Left MDR has stalled
         LeftMDR_BadHall { S7_HMI_Visible := 'False'} : Bool;   // The Left MDR has a Hall Efect Sensor error
         LeftMDR_NotUsed { S7_HMI_Visible := 'False'} : Bool;   // The Left MDR is not used
         Reserved_for_Modbus { S7_HMI_Visible := 'False'} : Bool;
         Reserved_1 { S7_HMI_Visible := 'False'} : Bool;
         OverVoltage { S7_HMI_Visible := 'False'} : Bool;   // The sum of the module power supply voltage + the MDR-generated voltage has exceeded 30 volts
         LeftMDR_AnyErr { S7_HMI_Visible := 'False'} : Bool;   // A general error on the Left MDR.
         ConnectionsNotOK { S7_HMI_Visible := 'False'} : Bool;   // The Ethernet connections are not ok .
         UpstreamJamErr { S7_HMI_Visible := 'False'} : Bool;   // Jam error is present on Upstream zone
         LeftSensLowGain { S7_HMI_Visible := 'False'} : Bool;   // Left sensor error
         LowVoltage { S7_HMI_Visible := 'False'} : Bool;   // Module power supply is less than 18 Volts
         RightMDR_Overheat { S7_HMI_Visible := 'False'} : Bool;   // The Right MDR temperature has exceeded 105 degrees Celsius
         RightMDR_MaxTorque { S7_HMI_Visible := 'False'} : Bool;   // The Right MDR is running with maximum torque output
         RightMDR_Short { S7_HMI_Visible := 'False'} : Bool;   // There is a short circuit on the Right MDR
         RightMDR_NotConn { S7_HMI_Visible := 'False'} : Bool;   // The Right MDR is not connected
         RightMDR_Overload { S7_HMI_Visible := 'False'} : Bool;   // The Right MDR has been overloaded - this means its speed is less than 10% of the selected speed
         RightMDR_Stalled { S7_HMI_Visible := 'False'} : Bool;   // The Right MDR has stalled
         RightMDR_BadHall { S7_HMI_Visible := 'False'} : Bool;   // The Right MDR has a Hall Efect Sensor error
         RightMDR_NotUsed { S7_HMI_Visible := 'False'} : Bool;   // The Right MDR is not used
         Reserved { S7_HMI_Visible := 'False'} : Bool;
         Reserved_2 { S7_HMI_Visible := 'False'} : Bool;
         OverVoltage1 { S7_HMI_Visible := 'False'} : Bool;   // The sum of the module power supply voltage + the MDR-generated voltage has exceeded 30 volts
         RightMDR_AnyErr { S7_HMI_Visible := 'False'} : Bool;   // A general error on the Right MDR.
         Reserved_3 { S7_HMI_Visible := 'False'} : Bool;
         DownstreamJamErr { S7_HMI_Visible := 'False'} : Bool;   // Jam error is present on Downstream zone
         RightSensLowGain { S7_HMI_Visible := 'False'} : Bool;   // Right sensor error
         LowVoltage1 { S7_HMI_Visible := 'False'} : Bool;   // Module power supply is less than 18 Volts
      END_STRUCT;
      ReleaseCounterUpstreamZone { S7_HMI_Visible := 'False'} : Int;   // Same register as is read in the ECCDFCZPA_OUT instance .Used to confirm the ReleaseCounter
      ReleaseCounterDownstreamZone { S7_HMI_Visible := 'False'} : Int;   // Same register as is read in the ECCDFCZPA_OUT instance .Used to confirm the ReleaseCounter
      AllSensors { S7_HMI_Visible := 'False'} : Struct   // All sensor inputs
         "Reserved[0]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[1]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[2]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[3]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[4]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[5]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[6]" { S7_HMI_Visible := 'False'} : Bool;
         Heartbeat { S7_HMI_Visible := 'False'} : Bool;   // This bit toggles every 2 seconds .
         LeftPin2 { S7_HMI_Visible := 'False'} : Bool;   // Left sensor port state (Pin2)
         "Reserved[9]" { S7_HMI_Visible := 'False'} : Bool;
         RightPin2 { S7_HMI_Visible := 'False'} : Bool;   // Right sensor port state (Pin2)
         "Reserved[11]" { S7_HMI_Visible := 'False'} : Bool;
         LeftSensor { S7_HMI_Visible := 'False'} : Bool;   // Left sensor port state (Pin4)
         "Reserved[13]" { S7_HMI_Visible := 'False'} : Bool;
         RightSensor { S7_HMI_Visible := 'False'} : Bool;   // Right sensor port state (Pin4)
         "Reserved[15]" { S7_HMI_Visible := 'False'} : Bool;
      END_STRUCT;
      Future { S7_HMI_Visible := 'False'} : Array[11..14] of Word;
   END_STRUCT;

END_TYPE

TYPE "ECCDFCPLC4PD_OUT"
VERSION : 0.1
   STRUCT
      Control : Struct
         LeftMDRRun : Bool;   // Left MDR Run = 1 / MDR Stop = 0
         LeftMDRDirection : Bool;   // Left MDR: 0 = Configured direction /1 = opposite to configured direction
         RightMDRRun : Bool;   // Right MDR Run = 1 / MDR Stop = 0
         RightMDRDirection : Bool;   // Right MDR: 0 = Configured direction /1 = opposite to configured direction
         LeftPin2SetOutput : Bool;   // Setting this bit sets the Left PIN2 to be used as Digital Output / 0 = Digital input
         LeftPin2Drive : Bool;   // Setting this bit drives the Left PIN2 to logical 1
         RightPin2SetOutput : Bool;   // Setting this bit sets the Right PIN2 to be used as Digital Output/ 0 = Digital input
         RightPin2Drive : Bool;   // Setting this bit drives the Right PIN2 to logical 1
         ClearMDRError : Bool;   // Writing '1' to this field clears the MDR error .There needs to be a transition from 0 to 1 in order to clear the error .
         LeftPin2Polarity : Bool;   // Normal polarity = 0 / Inverted polarity = 1
         RightPin2Polarity : Bool;   // Normal polarity = 0 / Inverted polarity = 1
         LeftPin4Polarity : Bool;   // Normal polarity = 0 / Inverted polarity = 1
         RightPin4Polarity : Bool;   // Normal polarity = 0 / Inverted polarity = 1
         reserved1 : Bool;
         reserved2 : Bool;
         reserved3 : Bool;
      END_STRUCT;
      LeftMDRSpeed : Word;   // The speed of the MDR in m/s*1000 or in shaft RPM*10 for ECG.
      RightMDRSpeed : Word;   // The speed of the MDR in m/s*1000 or in shaft RPM*10 for ECG.
      OutputWord : Word;   // Selectable Output WORD
   END_STRUCT;

END_TYPE

TYPE "ECCDFCPLC4PD_IN"
VERSION : 0.1
   STRUCT
      LeftSideStatus { S7_HMI_Visible := 'False'} : Struct   // Left Side Status.
         Overheat { S7_HMI_Visible := 'False'} : Bool;   // The MDR 's temperature has exceeded 105 degrees Celsius
         MaxTorque { S7_HMI_Visible := 'False'} : Bool;   // The MDR is running with maximum torque output
