         Stalled { S7_HMI_Visible := 'False'} : Bool;   // The MDR has stalled
         MDRBadHall { S7_HMI_Visible := 'False'} : Bool;   // The MDR has a Hall Efect Sensor error
         LeftMDRAnyError { S7_HMI_Visible := 'False'} : Bool;   // This bit toggles when any of the motor errors is active
         MDRStatus1 { S7_HMI_Visible := 'False'} : Bool;   // This field and the next are used together by the module to indicate the status of the MDR. Please refer to documentation
         MDRStatus2 { S7_HMI_Visible := 'False'} : Bool;
         Heartbeat { S7_HMI_Visible := 'False'} : Bool;   // This bit toggles every 2 seconds .
         LeftPin2 { S7_HMI_Visible := 'False'} : Bool;   // Left sensor port state (Pin2)
         LeftPin4 { S7_HMI_Visible := 'False'} : Bool;   // Left sensor port state (Pin4)
         LeftSensorDetect { S7_HMI_Visible := 'False'} : Bool;   // Device is connected to Left Sensor Port
         OverVoltage { S7_HMI_Visible := 'False'} : Bool;   // The sum of the module power supply voltage + the MDR-generated voltage has exceeded 30 volts
         LowVoltage { S7_HMI_Visible := 'False'} : Bool;   // Module power supply is less than 18 Volts
      END_STRUCT;
      RightSideStatus { S7_HMI_Visible := 'False'} : Struct   // Right Side Status.
         Overheat { S7_HMI_Visible := 'False'} : Bool;   // The MDR 's temperature has exceeded 105 degrees Celsius
         MaxTorque { S7_HMI_Visible := 'False'} : Bool;   // The MDR is running with maximum torque output
         ShortCircuit { S7_HMI_Visible := 'False'} : Bool;   // There is a short circuit on the MDR
         MDRNotConnected { S7_HMI_Visible := 'False'} : Bool;   // The MDR is not connected
         Overload { S7_HMI_Visible := 'False'} : Bool;   // The MDR has been overloaded - this means its speed is less than 10% of the selected speed
         Stalled { S7_HMI_Visible := 'False'} : Bool;   // The MDR has stalled
         MDRBadHall { S7_HMI_Visible := 'False'} : Bool;   // The motor has a Hall Efect Sensor error
         RightMDRAnyError { S7_HMI_Visible := 'False'} : Bool;   // This bit toggles when any of the motor errors is active
         MDRStatus1 { S7_HMI_Visible := 'False'} : Bool;   // This field and the next are used together by the module to indicate the status of the motor. Please refer to documentation
         MDRStatus2 { S7_HMI_Visible := 'False'} : Bool;
         Heartbeat { S7_HMI_Visible := 'False'} : Bool;   // This bit toggles every 2 seconds .
         RightPin2 { S7_HMI_Visible := 'False'} : Bool;   // Right sensor port state (Pin2)
         RightPin4 { S7_HMI_Visible := 'False'} : Bool;   // Right sensor port state (Pin4)
         RightSensorDetect { S7_HMI_Visible := 'False'} : Bool;   // Device is connected to Right Sensor Port
         OverVoltage { S7_HMI_Visible := 'False'} : Bool;   // The sum of the module power supply voltage + the MDR-generated voltage has exceeded 30 volts
         LowVoltage { S7_HMI_Visible := 'False'} : Bool;   // Module power supply is less than 18 Volts
      END_STRUCT;
      InputWord : Word;   // Selectable Input WORD
      InputWord2 : Word;   // Selectable Input WORD 2
   END_STRUCT;

END_TYPE

