TYPE "ECCDFCZPA_IN"
VERSION : 0.1
   STRUCT
      StateUpstreamZoneInverce { S7_HMI_Visible := 'False'} : Byte;   // Zone status when the conveyor is running in opposite to configured direction .The values have the same meaning as in "StateUpstreamZone" field
      StateUpstreamZone { S7_HMI_Visible := 'False'} : Byte;   // Empty =1 /Empty Motor Run = 2 /Empty Sending = 3 / Full Running = 4 / Full Stopped = 5 / Empty but Accumulate = 6
      StateDownstreamZoneInverce { S7_HMI_Visible := 'False'} : Byte;   // Zone status when the conveyor is running in opposite to configured direction  .The values have the same meaning as in "StateDownstreamZone" field
      StateDownstreamZone { S7_HMI_Visible := 'False'} : Byte;   // Empty =1 /Empty Motor Run = 2 /Empty Sending = 3 / Full Running = 4 / Full Stopped = 5 / Empty but Accumulate = 6
      ArrivalCounterUpstreamZone { S7_HMI_Visible := 'False'} : Int;   // Every time a product arrives on the Upstream zone this counter is incremented
      DisarrivalCounterUpstreamZone { S7_HMI_Visible := 'False'} : Int;   // Every time a product leaves the Upstream zone this counter is incremented
      ArrivalCounterDownstreamZone { S7_HMI_Visible := 'False'} : Int;   // Every time a product arrives on the Downstream zone this counter is incremented
      DisarrivalCounterDownstreamZone { S7_HMI_Visible := 'False'} : Int;   // Every time a product leaves the Downstream zone this counter is incremented
      Diagnostic { S7_HMI_Visible := 'False'} : Struct   // 32 bit diagnostic field . When bits are set the error is active .
         LeftMDR_Overheat { S7_HMI_Visible := 'False'} : Bool;   // The Left MDR temperature has exceeded 105 degrees Celsius
         LeftMDR_MaxTorque { S7_HMI_Visible := 'False'} : Bool;   // The Left MDR is running with maximum torque output
         LeftMDR_Short { S7_HMI_Visible := 'False'} : Bool;   // There is a short circuit on the Left MDR
         LeftMDR_NotConn { S7_HMI_Visible := 'False'} : Bool;   // The Left MDR  is not connected
         LeftMDR_Overload { S7_HMI_Visible := 'False'} : Bool;   // The Left MDR  has been overloaded - this means its speed is less than 10% of the selected speed
         LeftMDR_Stalled { S7_HMI_Visible := 'False'} : Bool;   // The Left MDR  has stalled
         LeftMDR_BadHall { S7_HMI_Visible := 'False'} : Bool;   // The Left MDR  has a Hall Efect Sensor error
         LeftMDR_NotUsed { S7_HMI_Visible := 'False'} : Bool;   // The Left MDR  is not used
         Reserved_for_Modbus { S7_HMI_Visible := 'False'} : Bool;
         Reserved_1 { S7_HMI_Visible := 'False'} : Bool;
         OverVoltage { S7_HMI_Visible := 'False'} : Bool;   // The sum of the module power supply voltage + the MDR -generated voltage has exceeded 30 volts
         LeftMDR_AnyErr { S7_HMI_Visible := 'False'} : Bool;   // A general error on the Left MDR.
         ConnectionsNotOK { S7_HMI_Visible := 'False'} : Bool;   // The Ethernet connections are not ok .
         UpstreamJamErr { S7_HMI_Visible := 'False'} : Bool;   // Jam error is present on Upstream zone
         LeftSensLowGain { S7_HMI_Visible := 'False'} : Bool;   // Left sensor error
         LowVoltage { S7_HMI_Visible := 'False'} : Bool;   // Module power supply is less than 18 Volts
         RightMDR_Overheat { S7_HMI_Visible := 'False'} : Bool;   // The Right MDR  temperature has exceeded 105 degrees Celsius
         RightMDR_MaxTorque { S7_HMI_Visible := 'False'} : Bool;   // The Right MDR is running with maximum torque output
         RightMDR_Short { S7_HMI_Visible := 'False'} : Bool;   // There is a short circuit on the Right MDR
         RightMDR_NotConn { S7_HMI_Visible := 'False'} : Bool;   // The Right MDR  is not connected
         RightMDR_Overload { S7_HMI_Visible := 'False'} : Bool;   // The Right MDR  has been overloaded - this means its speed is less than 10% of the selected speed
         RightMDR_Stalled { S7_HMI_Visible := 'False'} : Bool;   // The Right MDR  has stalled
         RightMDR_BadHall { S7_HMI_Visible := 'False'} : Bool;   // The Right MDR  has a Hall Efect Sensor error
         RightMDR_NotUsed { S7_HMI_Visible := 'False'} : Bool;   // The Right MDR  is not used
         Reserved { S7_HMI_Visible := 'False'} : Bool;
         Reserved_2 { S7_HMI_Visible := 'False'} : Bool;
         OverVoltage1 { S7_HMI_Visible := 'False'} : Bool;   // The sum of the module power supply voltage + the MDR -generated voltage has exceeded 30 volts
         RightMDR_AnyErr { S7_HMI_Visible := 'False'} : Bool;   // A general error on the Right MDR.
         Reserved_3 { S7_HMI_Visible := 'False'} : Bool;
         DownstreamJamErr { S7_HMI_Visible := 'False'} : Bool;   // Jam error is present on Downstream zone
         RightSensLowGain { S7_HMI_Visible := 'False'} : Bool;   // Right sensor error
         LowVoltage1 { S7_HMI_Visible := 'False'} : Bool;   // Module power supply is less than 18 Volts
      END_STRUCT;
      TrackingUpstreamZone { S7_HMI_Visible := 'False'} : DWord;   // The Tracking data of the product currently on this zone
      TrackingDownstreamZone { S7_HMI_Visible := 'False'} : DWord;   // The Tracking data of the product currently on this zone
      ReleaseCounterUpstreamZone { S7_HMI_Visible := 'False'} : Int;   // Same register as is read in the ECCDFCZPA_OUT instance .Used to confirm the ReleaseCounter
      ReleaseCounterDownstreamZone { S7_HMI_Visible := 'False'} : Int;   // Same register as is read in the ECCDFCZPA_OUT instance .Used to confirm the ReleaseCounter
      ModuleDischargeTracking { S7_HMI_Visible := 'False'} : DWord;   // Tracking data of a product that has just been discharged to a non-ECC-DFC-24-00 part of a conveyor , when the module is operating in default direction
      ModuleDischargeTrackingInverce { S7_HMI_Visible := 'False'} : DWord;   // Tracking data of a product that has just been discharged to a non-ECC-DFC-24-00 part of a conveyor , when the module is operating in opposite to default direction
      AllSensors { S7_HMI_Visible := 'False'} : Struct   // All sensor inputs
         "Reserved[0]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[1]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[2]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[3]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[4]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[5]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[6]" { S7_HMI_Visible := 'False'} : Bool;
         Heartbeat { S7_HMI_Visible := 'False'} : Bool;   // This bit toggles every 2 seconds .
         LeftPin2 { S7_HMI_Visible := 'False'} : Bool;   // Left sensor port state (Pin2)
         "Reserved[9]" { S7_HMI_Visible := 'False'} : Bool;
         RightPin2 { S7_HMI_Visible := 'False'} : Bool;   // Right sensor port state (Pin2)
         "Reserved[11]" { S7_HMI_Visible := 'False'} : Bool;
         LeftSensor { S7_HMI_Visible := 'False'} : Bool;   // Left sensor port state (Pin4)
         "Reserved[13]" { S7_HMI_Visible := 'False'} : Bool;
         RightSensor { S7_HMI_Visible := 'False'} : Bool;   // Right sensor port state (Pin4)
         "Reserved[15]" { S7_HMI_Visible := 'False'} : Bool;
      END_STRUCT;
      Reserved { S7_HMI_Visible := 'False'} : Word;
      Convey_stop_status { S7_HMI_Visible := 'False'} : Struct   // Status of ConveyStop
         Reserved0 { S7_HMI_Visible := 'False'} : Bool;
         Reserved1 { S7_HMI_Visible := 'False'} : Bool;
         StopActiveCommandPLC { S7_HMI_Visible := 'False'} : Bool;   // Stop active due to stop command from the PLC
         Reserved3 { S7_HMI_Visible := 'False'} : Bool;
         Reserved4 { S7_HMI_Visible := 'False'} : Bool;
         Reserved5 { S7_HMI_Visible := 'False'} : Bool;
         Reserved6 { S7_HMI_Visible := 'False'} : Bool;
         Reserved7 { S7_HMI_Visible := 'False'} : Bool;
         Reserved8 { S7_HMI_Visible := 'False'} : Bool;
         Reserved9 { S7_HMI_Visible := 'False'} : Bool;
         Reserved10 { S7_HMI_Visible := 'False'} : Bool;
         Reserved11 { S7_HMI_Visible := 'False'} : Bool;
         Reserved12 { S7_HMI_Visible := 'False'} : Bool;
         StopActiveOtherModule { S7_HMI_Visible := 'False'} : Bool;   // Stop condition is active on a module in the Stop group
         StopActiveLostConn { S7_HMI_Visible := 'False'} : Bool;   // Stop is active due to a loss of communication connection
         StopActiveLostPLC { S7_HMI_Visible := 'False'} : Bool;   // Stop active due to a loss of connection with the PLC
      END_STRUCT;
      Future { S7_HMI_Visible := 'False'} : Array[21..31] of Word;
   END_STRUCT;

END_TYPE

TYPE "ECCDFCPLCmini_OUT"
VERSION : 0.1
   STRUCT
      Reserved : Word;
      Reserved_1 : Word;
      SensorPortsDO { S7_HMI_Visible := 'False'} : Struct   // The Sensor ports PIN2 as  digital outputs
         "Reserved[0]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[1]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[2]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[3]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[4]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[5]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[6]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[7]" { S7_HMI_Visible := 'False'} : Bool;
         DriveLeftPIN2 { S7_HMI_Visible := 'False'} : Bool;   // Setting this bit drives the Left PIN2 to logical 1
         DriveRightPIN2 { S7_HMI_Visible := 'False'} : Bool;   // Setting this bit drives the Right PIN2 to logical 1
         "Reserved[10]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[11]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[12]" { S7_HMI_Visible := 'False'} : Bool;
         SetLeftPIN2asDO { S7_HMI_Visible := 'False'} : Bool;   // Setting this bit sets the Left PIN2 to be used as Digital Output / 0 = Digital input
         SetRightPIN2asDO { S7_HMI_Visible := 'False'} : Bool;   // Setting this bit sets the Right PIN2 to be used as Digital Output/ 0 = Digital input
         "Reserved[15]" { S7_HMI_Visible := 'False'} : Bool;
      END_STRUCT;
      LeftMDRControl { S7_HMI_Visible := 'False'} : Struct   // Run/Stop and Direction control of the Left MDR
         MDR_Direction { S7_HMI_Visible := 'False'} : Bool;   // 0 = Configured direction /1 = opposite to configured direction
         "Reserved[1]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[2]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[3]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[4]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[5]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[6]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[7]" { S7_HMI_Visible := 'False'} : Bool;
         Run_MDR { S7_HMI_Visible := 'False'} : Bool;   // MDR Run = 1 / MDR Stop = 0
         "Reserved[9]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[10]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[11]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[12]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[13]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[14]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[15]" { S7_HMI_Visible := 'False'} : Bool;
      END_STRUCT;
      RightMDRControl { S7_HMI_Visible := 'False'} : Struct   // Run/Stop and Direction control of the Right MDR
         MDR_Direction { S7_HMI_Visible := 'False'} : Bool;   // 0 = Configured direction /1 = opposite to configured direction
         "Reserved[1]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[2]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[3]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[4]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[5]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[6]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[7]" { S7_HMI_Visible := 'False'} : Bool;
         Run_MDR { S7_HMI_Visible := 'False'} : Bool;   // MDR Run = 1 / MDR Stop = 0
         "Reserved[9]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[10]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[11]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[12]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[13]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[14]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[15]" { S7_HMI_Visible := 'False'} : Bool;
      END_STRUCT;
      LeftMDRSpeed { S7_HMI_Visible := 'False'} : Int;   // The speed of the MDR in m/s*1000 (or in shaft RPM*10 for ECG). The allowed values depend on the Speed code of the MDR .
      RightMDRSpeed { S7_HMI_Visible := 'False'} : Int;   // The speed of the MDR in m/s*1000 (or in shaft RPM*10 for ECG). The allowed values depend on the Speed code of the MDR .
      ClearMDRError { S7_HMI_Visible := 'False'} : Word;   // Writing '1' to this field clears the MDR error .There needs to be a transition from 0 to 1 in order to clear the error .
   END_STRUCT;

END_TYPE

TYPE "ECCDFCZPA_OUT"
VERSION : 0.1
   STRUCT
      InductTrackingOnUpstreamZone { S7_HMI_Visible := 'False'} : DWord;   // Writes the tracking data of the product currently on the zone .The Release counter of the zone must be incremented by 1.
      InductTrackingOnDownstreamZone { S7_HMI_Visible := 'False'} : DWord;   // Writes the tracking data of the product currently on the zone .The Release counter of the zone must be incremented by 1.
      AccumulateControlUpstream { S7_HMI_Visible := 'False'} : Struct
         AccumUpstreamToThisZone { S7_HMI_Visible := 'False'} : Bool;   // Accumulates the Upstream zone relative to this zone .Useful in Merge/Divert operations
         FakeConfirm { S7_HMI_Visible := 'False'} : Bool;   // Fake confirmation bit . Useful for Divert operations . Please check documentation for more information .
         "Reserved[2]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[3]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[4]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[5]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[6]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[7]" { S7_HMI_Visible := 'False'} : Bool;
         Accumulate { S7_HMI_Visible := 'False'} : Bool;   // Accumulates this zone of this ECC-DFC-24-00 module
         "Reserved[9]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[10]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[11]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[12]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[13]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[14]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[15]" { S7_HMI_Visible := 'False'} : Bool;
      END_STRUCT;
      AccumulateControlDownstream { S7_HMI_Visible := 'False'} : Struct
         AccumUpstreamToThisZone { S7_HMI_Visible := 'False'} : Bool;   // Accumulates the Upstream zone relative to this zone .Useful in Merge/Divert operations
         FakeConfirm { S7_HMI_Visible := 'False'} : Bool;   // Fake confirmation bit . Useful for Divert operations . Please check documentation for more information .
         "Reserved[2]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[3]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[4]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[5]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[6]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[7]" { S7_HMI_Visible := 'False'} : Bool;
         Accumulate { S7_HMI_Visible := 'False'} : Bool;   // Accumulates this zone of this ECC-DFC-24-00 module
         "Reserved[9]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[10]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[11]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[12]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[13]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[14]" { S7_HMI_Visible := 'False'} : Bool;
         "Reserved[15]" { S7_HMI_Visible := 'False'} : Bool;
      END_STRUCT;
      SpeedLeftMDR { S7_HMI_Visible := 'False'} : Int;   // The speed of the MDR in m/s*1000 (or in shaft RPM*10 for ECG). The allowed values depend on the Speed code of the MDR .
      SpeedRightMDR { S7_HMI_Visible := 'False'} : Int;   // The speed of the MDR in m/s*1000 (or in shaft RPM*10 for ECG). The allowed values depend on the Speed code of the MDR .
      ReleaseControlUpstream { S7_HMI_Visible := 'False'} : Int;   // Changing the value causes the Upstream zone to release the current product . Even if  Accumulation is set for this zone , the current product is released
      ReleaseControlDownstream { S7_HMI_Visible := 'False'} : Int;   // Changing the value causes the Downstream zone to release the current product . Even if  Accumulation is set for this zone , the current product is released
      InductControlState { S7_HMI_Visible := 'False'} : Word;   // Used as a "Wake up" signal . If '4' is written the Zone will attempt to accept product . If 1 is written the zone will stop accepting .
      DishargeControlState { S7_HMI_Visible := 'False'} : Word;   // Used as a "Lane full" signal .Set 5 to cause the zone to accumulate product here . Set 1 to allow the zone to release the product .
      ModuleInductTrackingOnInductSide { S7_HMI_Visible := 'False'} : DWord;   // When the conveyor is running in configured direction ,writing Tracking data here will cause the next product to appear on the zone to have this tracking data assigned .
      ModuleInductTrackingOnDishargeSide { S7_HMI_Visible := 'False'} : DWord;   // When the conveyor is running in opposite to configured direction ,writing Tracking data here will cause the next product to appear on the zone to have this tracking data assigned .
      ClearMotorError { S7_HMI_Visible := 'False'} : Word;   // Writing '1' to this field clears the MDR error .There needs to be a transition from 0 to 1 in order to clear the error .
      Reserved { S7_HMI_Visible := 'False'} : Word;
      Reserved_1 { S7_HMI_Visible := 'False'} : Word;
      Convey_stop_control { S7_HMI_Visible := 'False'} : Word;   // Writing '1' causes the Stop group to go into STOP state . Writing '2' clears the STOP state. Transition 0 - 2 is needed to clear the Stop
      JamClearUpstream { S7_HMI_Visible := 'False'} : Word;   // Transition of this value from '0' to '1' clears the JAM condition on the zone
      JamClearDownstream { S7_HMI_Visible := 'False'} : Word;   // Transition of this value from '0' to '1' clears the JAM condition on the zone
      GlobalDirectionControlUpstream { S7_HMI_Visible := 'False'} : Word;   // Used to change direction of flow or accumulation mode for a continuous group of zones beginning with the local zone .
      GlobalDirectionControlDownstream { S7_HMI_Visible := 'False'} : Word;   // Used to change direction of flow or accumulation mode for a continuous group of zones beginning with the local zone .
      Future { S7_HMI_Visible := 'False'} : Array[24..31] of Word;
   END_STRUCT;

END_TYPE

